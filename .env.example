# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Google Sheets sync (leave both empty to disable)
# The full service-account key JSON, on one line
GOOGLE_SERVICE_ACCOUNT_JSON=
# The ID in the spreadsheet URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
